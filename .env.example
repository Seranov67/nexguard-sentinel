# Environment variable template for NexGuard Edge Resilience
# Copy this file to .env and fill in real values where needed.
# NEVER commit the real .env file.

# ── Gateway Simulator ─────────────────────────────────────────────────────────
GATEWAY_CONFIG_PATH=/data/gateway/gateway.yaml
PORT=8080

# ── NexGuard Controller ───────────────────────────────────────────────────────
GATEWAY_HEALTH_URL=http://gateway-simulator:8080/health
HEALTH_CHECK_INTERVAL_SECONDS=10
FAILURE_THRESHOLD=3
CONFIG_PATH=/data/gateway/gateway.yaml
BACKUP_DIR=/data/backups
BACKUP_INTERVAL_SECONDS=60
NEXGUARD_ALLOWED_CONTAINERS=gateway-simulator
RECOVERY_COOLDOWN_SECONDS=60
MAX_RECOVERIES_PER_WINDOW=3
RECOVERY_WINDOW_SECONDS=600
RESTART_WAIT_SECONDS=30
METRICS_PORT=8081
LOG_LEVEL=INFO

# ── Telegram (optional — leave empty to disable) ──────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Grafana ───────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME
GF_SECURITY_ADMIN_USER=admin
